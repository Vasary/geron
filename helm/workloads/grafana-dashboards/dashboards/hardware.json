      "id": 17,
      "title": "Throttled Time (%) — 15m",
      "description": "Percentage of the rolling 15-minute window spent in package thermal throttling. The percent sign is in the panel title to keep the gauge value compact. For this single-package host, 1 means 1% (9 seconds throttled during the last 15 minutes).",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
