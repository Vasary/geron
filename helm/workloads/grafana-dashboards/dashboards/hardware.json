          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (mountpoint) (100 * (1 - node_filesystem_avail_bytes{job=\"node-exporter\", instance=\"192.168.178.10:9100\", mountpoint=~\"/var|/var/mnt/local-path-nvme\"} / node_filesystem_size_bytes{job=\"node-exporter\", instance=\"192.168.178.10:9100\", mountpoint=~\"/var|/var/mnt/local-path-nvme\"}))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (mountpoint) ((node_filesystem_size_bytes{job=\"node-exporter\", instance=\"192.168.178.10:9100\", mountpoint=~\"/var|/var/mnt/local-path-nvme\"} - node_filesystem_avail_bytes{job=\"node-exporter\", instance=\"192.168.178.10:9100\", mountpoint=~\"/var|/var/mnt/local-path-nvme\"}) / 1e9)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (mountpoint) (node_filesystem_size_bytes{job=\"node-exporter\", instance=\"192.168.178.10:9100\", mountpoint=~\"/var|/var/mnt/local-path-nvme\"} / 1e9)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (mountpoint) (node_filesystem_avail_bytes{job=\"node-exporter\", instance=\"192.168.178.10:9100\", mountpoint=~\"/var|/var/mnt/local-path-nvme\"} / 1e9)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "mountpoint",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "mountpoint": true,
              "Value #A": true,
              "Value #B": true,
              "Value #C": true,
              "Value #D": true
            },
            "indexByName": {
              "mountpoint": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            },
            "renameByName": {
              "mountpoint": "Disk",
              "Value #A": "Usage",
              "Value #B": "Used",
              "Value #C": "Total",
              "Value #D": "Free"
            }
          }
        }
      ]
    },
