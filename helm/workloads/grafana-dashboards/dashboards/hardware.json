    {
      "id": 13,
      "title": "Uptime",
      "description": "Time since the last boot.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "No data",
          "mappings": [],
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "text": {
          "titleSize": 12,
          "valueSize": 28
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "node_time_seconds{job=\"node-exporter\", instance=\"192.168.178.10:9100\"} - node_boot_time_seconds{job=\"node-exporter\", instance=\"192.168.178.10:9100\"}",
          "legendFormat": "Uptime",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
