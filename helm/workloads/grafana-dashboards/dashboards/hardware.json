    {
      "id": 12,
      "title": "Throttle Events (15m)",
      "description": "Number of CPU package thermal-throttling events during the rolling last 15 minutes. This is increase(node_cpu_package_throttles_total[15m]), not a temperature, TjMax, or duration. Prometheus may calculate a fractional increase; the panel rounds it to a whole event.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 6,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "0",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "gray",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 28
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (instance) (increase(node_cpu_package_throttles_total{job=\"node-exporter\", instance=\"192.168.178.10:9100\"}[15m]))",
          "legendFormat": "Events / 15m",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
